# Production environment template (do not commit real credentials)
# Use values from your external PostgreSQL provider (Supabase or AWS RDS).
# Supabase usually requires SSL (`sslmode=require`).
# AWS RDS may require SSL depending on your DB parameter group and security settings.

APP_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:5432/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=your-database-user
SPRING_DATASOURCE_PASSWORD=your-database-password
