# PostgreSQL
POSTGRES_DB=searchzip
POSTGRES_USER=searchzip
POSTGRES_PASSWORD=searchzip

# Application (inside docker network, host "postgres")
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/searchzip
SPRING_DATASOURCE_USERNAME=searchzip
SPRING_DATASOURCE_PASSWORD=searchzip
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# CEP providers
CEP_CLIENT_WIREMOCK_URL=http://wiremock:8080
CEP_CLIENT_VIACEP_URL=https://viacep.com.br/ws

# App
APP_PORT=8080
