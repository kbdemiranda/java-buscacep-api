# PostgreSQL
POSTGRES_DB=buscacep
POSTGRES_USER=buscacep
POSTGRES_PASSWORD=buscacep
POSTGRES_PORT=5432

# Application (inside docker network, host "postgres")
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/buscacep
SPRING_DATASOURCE_USERNAME=buscacep
SPRING_DATASOURCE_PASSWORD=buscacep

# Flyway must run outside the app (docker compose flyway service)
SPRING_FLYWAY_ENABLED=false

# CEP providers
CEP_CLIENT_WIREMOCK_URL=http://wiremock:8080
CEP_CLIENT_VIACEP_URL=https://viacep.com.br/ws

# App
APP_PORT=8080
